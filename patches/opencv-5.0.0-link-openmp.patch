+    ocv_target_link_libraries(${the_module} PUBLIC OpenMP::OpenMP_CXX)
+  else()
+    ocv_target_link_libraries(${the_module} PUBLIC "${OpenMP_CXX_FLAGS}")
+  endif()
 endif()
 
 set(test_libs "")
