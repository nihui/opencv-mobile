diff -Nuarp opencv-5.0.0.orig/cmake/OpenCVFindFrameworks.cmake opencv-5.0.0/cmake/OpenCVFindFrameworks.cmake
--- opencv-5.0.0.orig/cmake/OpenCVFindFrameworks.cmake	2026-06-06 02:50:05.000000000 +0800
+++ opencv-5.0.0/cmake/OpenCVFindFrameworks.cmake	2026-07-10 23:21:15.347551097 +0800
@@ -29,6 +29,18 @@ endif()
 # --- OpenMP ---
 if(WITH_OPENMP)
   find_package(OpenMP)
+  if(MSVC)
+    # The MSVC OpenMP runtime is selected by the compiler flag. CMake 3.31 may
+    # mis-detect pthread as an additional implicit OpenMP library.
+    set(OpenMP_C_LIBRARIES "")
+    set(OpenMP_CXX_LIBRARIES "")
+    if(TARGET OpenMP::OpenMP_C)
+      set_property(TARGET OpenMP::OpenMP_C PROPERTY INTERFACE_LINK_LIBRARIES "")
+    endif()
+    if(TARGET OpenMP::OpenMP_CXX)
+      set_property(TARGET OpenMP::OpenMP_CXX PROPERTY INTERFACE_LINK_LIBRARIES "")
+    endif()
+  endif()
   if(OPENMP_FOUND)
     set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${OpenMP_C_FLAGS}")
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${OpenMP_CXX_FLAGS}")
